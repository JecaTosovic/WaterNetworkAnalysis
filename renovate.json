{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitsDisabled",
    ":label(dependencies)"
  ],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 5,
  "github-actions": {
    "automerge": true
  },
  "lockFileMaintenance": {
    "description": "Automate lockfile maintenance early on Thursdays.",
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0-3 * * 4"]
  },
  "pip-compile": {
    "managerFilePatterns": ["/.*requirements.*\\.(txt|pip)$/"],
    "automerge": true
  },
  "pip_requirements": {
    "enabled": true,
    "automerge": true
  },
  "pep621": {
    "automerge": true
  },
  "pip_setup": {
    "enabled": false
  },
  "pixi": {
    "enabled": true,
    "automerge": true
  },
  "pre-commit": {
    "automerge": true
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "matchManagers": ["pixi"],
      "groupName": "pixi dependencies"
    },
    {
      "matchManagers": ["pip_requirements", "pep621"],
      "groupName": "python dependencies"
    }
  ]
}
